SERVER_HOST=0.0.0.0
SERVER_PORT=8082
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=account-service
KAFKA_WRITE_TIMEOUT=5s
KAFKA_BATCH_TIMEOUT=10ms
KAFKA_PUBLISH_TIMEOUT=20s
KAFKA_MAX_ATTEMPTS=3

CONSUMER_RETRY_BACKOFF=200ms,1s,5s
CONSUMER_DRAIN_TIMEOUT=30s

CASSANDRA_HOSTS=localhost:9042
CASSANDRA_KEYSPACE=fintech_accounts
CASSANDRA_CONSISTENCY=LOCAL_QUORUM
CASSANDRA_TIMEOUT=10s
CASSANDRA_CONNECT_TIMEOUT=10s
CASSANDRA_MIGRATIONS_PATH=migrations

LOG_LEVEL=info
LOG_PRETTY=false
