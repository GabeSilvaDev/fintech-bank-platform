SERVER_HOST=0.0.0.0
SERVER_PORT=8085
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=notification-service
KAFKA_WRITE_TIMEOUT=5s
KAFKA_BATCH_TIMEOUT=10ms
KAFKA_PUBLISH_TIMEOUT=20s
KAFKA_MAX_ATTEMPTS=3

CONSUMER_RETRY_BACKOFF=200ms,1s,5s
CONSUMER_DRAIN_TIMEOUT=30s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

ACCOUNT_SERVICE_URL=http://localhost:8082
ACCOUNT_DIRECTORY_TTL=5m
ACCOUNT_DIRECTORY_TIMEOUT=3s

SMTP_ADDR=localhost:1025
SMTP_FROM=no-reply@fintech.local
SMTP_TIMEOUT=10s

NOTIFICATION_HISTORY_SIZE=100
NOTIFICATION_MAX_EVENT_AGE=1h

LOG_LEVEL=info
LOG_PRETTY=false

STARTUP_RETRY_ATTEMPTS=30
STARTUP_RETRY_DELAY=2s

METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLER_RATIO=1.0
