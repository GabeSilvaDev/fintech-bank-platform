SERVER_HOST=0.0.0.0
SERVER_PORT=8084
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=payment-service
KAFKA_WRITE_TIMEOUT=5s
KAFKA_BATCH_TIMEOUT=10ms
KAFKA_PUBLISH_TIMEOUT=20s
KAFKA_MAX_ATTEMPTS=3

CONSUMER_RETRY_BACKOFF=200ms,1s,5s
CONSUMER_DRAIN_TIMEOUT=30s

CASSANDRA_HOSTS=localhost:9042
CASSANDRA_KEYSPACE=fintech_payments
CASSANDRA_CONSISTENCY=LOCAL_QUORUM
CASSANDRA_TIMEOUT=10s
CASSANDRA_CONNECT_TIMEOUT=10s
CASSANDRA_MIGRATIONS_PATH=migrations

LOG_LEVEL=info
LOG_PRETTY=false

PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PAYMENT_WEBHOOK_URL=http://localhost:8084/webhooks/gateway
PAYMENT_WEBHOOK_TOLERANCE=5m
PAYMENT_SETTLEMENT_DELAY=2s

SWEEPER_ENABLED=true
SWEEPER_INTERVAL=1m
SWEEPER_STALE_AFTER=5m
SWEEPER_BATCH=100

STARTUP_RETRY_ATTEMPTS=30
STARTUP_RETRY_DELAY=2s
